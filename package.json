{
  "name": "pes6-manager",
  "version": "1.0.0",
  "description": "PES 6 Pro Career Manager Desktop Companion App",
  "main": "main.js",
  "author": "Jamal Mahmood",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.jamal.pes6careermanager",
    "productName": "PES 6 Pro Career Manager",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "style.css",
      "players.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
