{
  "name": "pes6-manager",
  "version": "1.0.0",
  "description": "PES 6 Pro Career Manager Desktop Companion App",
  "main": "main.js",
  "author": "Jamal Mahmood",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.jamal.pes6careermanager",
    "productName": "PES 6 Pro Career Manager",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PES 6 Pro Career Manager"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "style.css",
      "players.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}